<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as values/styles.xml. Android TV usually reports notnight, so the
         light variant is the one that actually applies; these are kept in step
         so a box that does report night behaves identically. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/shonenx_bg</item>
    </style>
</resources>
